+/// The 2D inverse transform one row, then one column, at a time in 32-bit
+/// arithmetic (not lossless; bit depth 10 at most), for coefficients that
+/// are zero outside the first `rows` rows and `cols` columns: what
+/// [`inverse_transform_2d_lanes`] does eight at a time.
+#[cfg_attr(
+    not(all(target_arch = "wasm32", not(target_feature = "simd128"))),
+    allow(dead_code)
+)]
+fn inverse_transform_2d_narrow(
+    dequant: &[i32],
+    tx_sz: usize,
+    tx_type: usize,
+    bit_depth: u32,
+    (rows, cols): (usize, usize),
+    residual: &mut [i32],
+) {
+    let log2w = TX_WIDTH_LOG2[tx_sz] as u32;
+    let log2h = TX_HEIGHT_LOG2[tx_sz] as u32;
+    let w = 1usize << log2w;
+    let h = 1usize << log2h;
+    let row_shift = TRANSFORM_ROW_SHIFT[tx_sz] as u32;
+    let row_clamp = bit_depth + 8;
+    let col_clamp = (bit_depth + 6).max(16);
+    let rk = row_kind(tx_type);
+    let ck = col_kind(tx_type);
+    let rect = log2w.abs_diff(log2h) == 1;
+    let lo = -(1i32 << (col_clamp - 1));
+    let hi = (1i32 << (col_clamp - 1)) - 1;
+    let add = (1i32 << row_shift) >> 1;
+    let mut t = [Narrow(0); 64];
+    for i in 0..rows {
+        let src = &dequant[i * 64..i * 64 + cols];
+        let out = &mut residual[i * w..(i + 1) * w];
+        if src.iter().all(|&v| v == 0) {
+            out.fill(0);
+            continue;
+        }
+        for (t, &v) in t.iter_mut().zip(src) {
+            *t = Narrow(v);
+        }
+        t[cols..w].fill(Narrow(0));
+        if rect {
+            for v in t[..cols].iter_mut() {
+                *v = Narrow::scale12(*v, 2896);
+            }
+        }
+        run_lanes(&mut t[..], rk, log2w, row_clamp);
+        for (o, t) in out.iter_mut().zip(&t) {
+            *o = (t.0.wrapping_add(add) >> row_shift).clamp(lo, hi);
+        }
+    }
+    for j in 0..w {
+        for i in 0..rows {
+            t[i] = Narrow(residual[i * w + j]);
+        }
+        t[rows..h].fill(Narrow(0));
+        run_lanes(&mut t[..], ck, log2h, col_clamp);
+        for i in 0..h {
+            residual[i * w + j] = t[i].0.wrapping_add(8) >> 4;
+        }
+    }
+}
