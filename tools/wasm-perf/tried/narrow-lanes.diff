+/// One value in 32-bit wrapping arithmetic: [`Lanes`]' arithmetic, a lane
+/// at a time, for a target with no vectors to put eight in. Exact under
+/// the same condition (bit depths up to 10, values in the ranges
+/// conformance requires).
+#[derive(Clone, Copy)]
+#[cfg_attr(
+    not(all(target_arch = "wasm32", not(target_feature = "simd128"))),
+    allow(dead_code)
+)]
+pub(crate) struct Narrow(pub(crate) i32);
+
+impl Lane for Narrow {
+    const N: usize = 1;
+    #[inline(always)]
+    fn zero() -> Self {
+        Narrow(0)
+    }
+    #[inline(always)]
+    fn rot(a: Self, ca: i32, b: Self, cb: i32) -> Self {
+        Narrow(
+            a.0.wrapping_mul(ca)
+                .wrapping_add(b.0.wrapping_mul(cb))
+                .wrapping_add(1 << 11)
+                >> 12,
+        )
+    }
+    #[inline(always)]
+    fn add_sub_clamp(a: Self, b: Self, lo: i32, hi: i32) -> (Self, Self) {
+        (
+            Narrow(a.0.wrapping_add(b.0).clamp(lo, hi)),
+            Narrow(a.0.wrapping_sub(b.0).clamp(lo, hi)),
+        )
+    }
+    #[inline(always)]
+    fn neg(a: Self) -> Self {
+        Narrow(a.0.wrapping_neg())
+    }
+    #[inline(always)]
+    fn scale12(a: Self, c: i32) -> Self {
+        Narrow(a.0.wrapping_mul(c).wrapping_add(1 << 11) >> 12)
+    }
+    #[inline(always)]
+    fn mul(a: Self, c: i32) -> Self {
+        Narrow(a.0.wrapping_mul(c))
+    }
+    #[inline(always)]
+    fn get(&self, _l: usize) -> i32 {
+        self.0
+    }
+    #[inline(always)]
+    fn set(&mut self, _l: usize, v: i32) {
+        self.0 = v;
+    }
+}
