+/// Block inter prediction from an unscaled reference straight into the
+/// frame, for a prediction that is final: one reference, nothing to blend
+/// it with. The arithmetic of `block_inter_prediction_unscaled` followed by
+/// the clip to the sample range that storing the prediction applies, with
+/// no 32-bit prediction buffer between them. `(dx, dy)` is the block's
+/// position in `dst`.
+#[cfg(not(target_arch = "x86_64"))]
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn block_inter_prediction_to_frame(
+    refp: &PlaneBuf,
+    last_x: i32,
+    last_y: i32,
+    x: i64,
+    y: i64,
+    w: usize,
+    h: usize,
+    interp_filter: [u8; 2],
+    rv: RoundingVars,
+    maxv: u16,
+    dst: &mut PlaneBuf,
+    dx: usize,
+    dy: usize,
+) {
+    let [filt_y, filt_x] = filter_kinds(interp_filter, w, h);
+    let phase_x = ((x >> 6) & SUBPEL_MASK as i64) as usize;
+    let phase_y = (((y & 1023) >> 6) & SUBPEL_MASK as i64) as usize;
+    let fx = &SUBPEL_FILTERS[filt_x][phase_x];
+    let fy = &SUBPEL_FILTERS[filt_y][phase_y];
+    let x0 = (x >> 10) - 3;
+    let y0 = (y >> 10) - 3;
+    let inside_x = x0 >= 0 && x0 + w as i64 + 7 <= last_x as i64 + 1;
+    let mut padded = [0u16; 128 + 8];
+    let (round0, round1) = (rv.round0, rv.round1);
+    let stride = dst.stride;
+    if phase_y == 0 {
+        // The vertical filter is `128 * intermediate`, of the `h` rows it
+        // reads.
+        let add = (1 << round1) >> 1;
+        let mut line = [0i16; 128];
+        for r in 0..h {
+            let src = source_row(
+                refp,
+                y0 + r as i64 + 3,
+                x0,
+                w,
+                inside_x,
+                last_x,
+                last_y,
+                &mut padded,
+            );
+            crate::dsp::mc::filter_row16(src, fx, round0, &mut line[..w]);
+            let out = &mut dst.data[(dy + r) * stride + dx..][..w];
+            for (o, &v) in out.iter_mut().zip(&line[..w]) {
+                *o = ((128 * v as i32 + add) >> round1).clamp(0, maxv as i32) as u16;
+            }
+        }
+        return;
+    }
+    // The intermediate array: a per-thread buffer, reused.
+    thread_local! {
+        static SCRATCH: std::cell::RefCell<Vec<i16>> = const { std::cell::RefCell::new(Vec::new()) };
+    }
+    let inter_h = h + 7;
+    SCRATCH.with(|buf| {
+        let mut buf = buf.borrow_mut();
+        if buf.len() < inter_h * w {
+            buf.resize(inter_h * w, 0);
+        }
+        let intermediate = &mut buf[..inter_h * w];
+        for (r, out) in intermediate.chunks_exact_mut(w).enumerate() {
+            let src = source_row(
+                refp,
+                y0 + r as i64,
+                x0,
+                w,
+                inside_x,
+                last_x,
+                last_y,
+                &mut padded,
+            );
+            if phase_x == 0 {
+                let shift = 7 - round0;
+                for (o, &s) in out.iter_mut().zip(&src[3..]) {
+                    *o = (s << shift) as i16;
+                }
+            } else {
+                crate::dsp::mc::filter_row16(src, fx, round0, out);
+            }
+        }
+        for r in 0..h {
+            let out = &mut dst.data[(dy + r) * stride + dx..][..w];
+            crate::dsp::mc::filter_col16_clamped(&intermediate[r * w..], w, fy, round1, maxv, out);
+        }
+    })
+}
