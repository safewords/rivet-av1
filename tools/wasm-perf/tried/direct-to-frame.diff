+/// [`filter_col16`] for a prediction that is final (one reference, nothing
+/// to blend): the result clipped to `0..=maxv` and stored as samples.
+#[cfg_attr(target_arch = "x86_64", allow(dead_code))]
+#[inline]
+pub(crate) fn filter_col16_clamped(
+    rows: &[i16],
+    w: usize,
+    f: &[i32; 8],
+    round1: u32,
+    maxv: u16,
+    out: &mut [u16],
+) {
+    debug_assert!(rows.len() >= 8 * w && out.len() == w);
+    #[cfg(all(target_arch = "wasm32", target_feature = "simd128"))]
+    if w >= 4 {
+        filter_col16_clamped_simd128(rows, w, f, round1, maxv, out);
+        return;
+    }
+    filter_col16_clamped_scalar(rows, w, f, round1, maxv, out)
+}
+
+pub(crate) fn filter_col16_clamped_scalar(
+    rows: &[i16],
+    w: usize,
+    f: &[i32; 8],
+    round1: u32,
+    maxv: u16,
+    out: &mut [u16],
+) {
+    let add = (1 << round1) >> 1;
+    let rows = &rows[..8 * w];
+    for (c, o) in out.iter_mut().enumerate() {
+        let mut acc = add;
+        for t in 0..8 {
+            acc += f[t] * rows[t * w + c] as i32;
+        }
+        *o = (acc >> round1).clamp(0, maxv as i32) as u16;
+    }
+}
+
+/// As [`filter_col16_simd128`], the sums narrowed to samples (saturating
+/// at zero) and limited to `maxv`.
+#[cfg(all(target_arch = "wasm32", target_feature = "simd128"))]
+fn filter_col16_clamped_simd128(
+    rows: &[i16],
+    w: usize,
+    f: &[i32; 8],
+    round1: u32,
+    maxv: u16,
+    out: &mut [u16],
+) {
+    use std::arch::wasm32::*;
+    assert!(w >= 4 && rows.len() >= 8 * w && out.len() == w);
+    let (coef, used) = tap_pairs(f);
+    let add = i32x4_splat((1 << round1) >> 1);
+    let top = u16x8_splat(maxv);
+    let rp = rows.as_ptr();
+    let op = out.as_mut_ptr();
+    let step = if w < 8 { 4 } else { 8 };
+    let mut c = 0;
+    while c < w {
+        let c0 = c.min(w - step);
+        let (mut lo, mut hi) = (add, add);
+        for k in 0..4 {
+            if !used[k] {
+                continue;
+            }
+            // SAFETY: `step` samples of rows 2k and 2k + 1, c0 + step <= w.
+            let (a, b) = unsafe {
+                let (pa, pb) = (rp.add(2 * k * w + c0), rp.add((2 * k + 1) * w + c0));
+                if step == 8 {
+                    (v128_load(pa as *const v128), v128_load(pb as *const v128))
+                } else {
+                    (
+                        v128_load64_zero(pa as *const u64),
+                        v128_load64_zero(pb as *const u64),
+                    )
+                }
+            };
+            let l = i16x8_shuffle::<0, 8, 1, 9, 2, 10, 3, 11>(a, b);
+            lo = i32x4_add(lo, i32x4_dot_i16x8(l, coef[k]));
+            if step == 8 {
+                let h = i16x8_shuffle::<4, 12, 5, 13, 6, 14, 7, 15>(a, b);
+                hi = i32x4_add(hi, i32x4_dot_i16x8(h, coef[k]));
+            }
+        }
+        let v = u16x8_min(
+            u16x8_narrow_i32x4(i32x4_shr(lo, round1), i32x4_shr(hi, round1)),
+            top,
+        );
+        // SAFETY: c0 + step <= w = out.len().
+        unsafe {
+            if step == 8 {
+                v128_store(op.add(c0) as *mut v128, v);
+            } else {
+                v128_store64_lane::<0>(v, op.add(c0) as *mut u64);
+            }
+        }
+        c = c0 + step;
+    }
+}
