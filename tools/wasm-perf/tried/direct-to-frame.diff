+/// The rows of `Subpel_Filters` a block's two filters come from,
+/// `[vertical, horizontal]`: `interp_filter`, with the 4-tap sets for a
+/// dimension of 4 or less (7.11.3.4).
+fn filter_kinds(interp_filter: [u8; 2], w: usize, h: usize) -> [usize; 2] {
+    let short = |f: u8, n: usize| -> usize {
+        let f = f as usize;
+        if n > 4 {
+            f
+        } else if f == EIGHTTAP as usize || f == EIGHTTAP_SHARP as usize {
+            4
+        } else if f == EIGHTTAP_SMOOTH as usize {
+            5
+        } else {
+            f
+        }
+    };
+    [short(interp_filter[0], h), short(interp_filter[1], w)]
+}
+
+/// `w + 7` samples of row `yy` of a reference from column `x0`, the row
+/// and the columns clamped to the reference (its edges repeated): the row
+/// itself when it holds them all, else gathered into `padded`.
+#[cfg(not(target_arch = "x86_64"))]
+#[inline(always)]
+#[allow(clippy::too_many_arguments)]
+fn source_row<'a>(
+    refp: &'a PlaneBuf,
+    yy: i64,
+    x0: i64,
+    w: usize,
+    inside_x: bool,
+    last_x: i32,
+    last_y: i32,
+    padded: &'a mut [u16; 128 + 8],
+) -> &'a [u16] {
+    let row = refp.row(clip3(0, last_y, yy as i32) as usize);
+    if inside_x {
+        &row[x0 as usize..x0 as usize + w + 7]
+    } else {
+        for (c, v) in padded[..w + 7].iter_mut().enumerate() {
+            *v = row[clip3(0, last_x, (x0 + c as i64) as i32) as usize];
+        }
+        &padded[..w + 7]
+    }
+}
