+#[cfg(all(target_arch = "wasm32", target_feature = "simd128"))]
+fn copy_samples_simd128(
+    src: &[u16],
+    src_stride: usize,
+    w: usize,
+    h: usize,
+    dst: &mut [u16],
+    dst_stride: usize,
+) {
+    use std::arch::wasm32::*;
+    assert!(w >= 8 && h > 0);
+    assert!(src.len() >= (h - 1) * src_stride + w && dst.len() >= (h - 1) * dst_stride + w);
+    for r in 0..h {
+        // SAFETY: row r of each, which the assertions put inside.
+        let (sp, dp) = unsafe {
+            (
+                src.as_ptr().add(r * src_stride),
+                dst.as_mut_ptr().add(r * dst_stride),
+            )
+        };
+        // Whole vectors, then one more ending at the last column
+        // (overlapping what is done: the same values are stored again).
+        let mut c = 0;
+        while c < w {
+            let c0 = c.min(w - 8);
+            // SAFETY: c0 + 8 <= w, and every row holds w samples.
+            unsafe {
+                v128_store(
+                    dp.add(c0) as *mut v128,
+                    v128_load(sp.add(c0) as *const v128),
+                )
+            };
+            c = c0 + 8;
+        }
+    }
+}
