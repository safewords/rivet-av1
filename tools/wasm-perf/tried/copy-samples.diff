+/// A block of a reference's samples, copied: a prediction with no
+/// fractional part and nothing to blend with. Row `r` of each starts at
+/// `r` times its stride.
+///
+/// A wasm module's `copy_from_slice` is `memory.copy`, which V8 leaves to a
+/// call out of the compiled code: for the 8 to 64 samples of a block's row
+/// that call costs more than the copy. The SIMD128 version loads and
+/// stores the row's vectors itself.
+#[inline]
+pub(crate) fn copy_samples(
+    src: &[u16],
+    src_stride: usize,
+    w: usize,
+    h: usize,
+    dst: &mut [u16],
+    dst_stride: usize,
+) {
+    #[cfg(all(target_arch = "wasm32", target_feature = "simd128"))]
+    if w >= 8 {
+        copy_samples_simd128(src, src_stride, w, h, dst, dst_stride);
+        return;
+    }
+    for r in 0..h {
+        dst[r * dst_stride..][..w].copy_from_slice(&src[r * src_stride..][..w]);
+    }
+}
