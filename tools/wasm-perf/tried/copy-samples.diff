+
+    /// A copied block is the block, and nothing around it is touched.
+    #[test]
+    fn copies_are_copies() {
+        let mut seed = 0x3c6e_f372_fe94_f82bu64;
+        let mut rnd = |n: u64| {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            seed % n
+        };
+        for w in [2usize, 4, 8, 12, 16, 32, 64, 128] {
+            for h in [1usize, 2, 5, 8] {
+                let (ss, ds) = (w + rnd(7) as usize, w + rnd(7) as usize);
+                let src: Vec<u16> = (0..h * ss).map(|_| rnd(1 << 12) as u16).collect();
+                let mut want = vec![9u16; h * ds];
+                for r in 0..h {
+                    want[r * ds..][..w].copy_from_slice(&src[r * ss..][..w]);
+                }
+                let mut got = vec![9u16; h * ds];
+                copy_samples(&src, ss, w, h, &mut got, ds);
+                assert_eq!(want, got, "{w}x{h}");
+            }
+        }
+    }
 }
