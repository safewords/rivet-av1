+/// [`run_lanes`] for an input whose entries from `nonzero` on are zero.
+#[inline(always)]
+fn run_lanes_first<L: Lane>(t: &mut [L], kind: Kind, n: u32, r: u32, nonzero: usize) {
+    if kind == Kind::Dct {
+        let mut tx = Tx { t: &mut *t };
+        match (n, nonzero) {
+            (4, ..=8) => return tx.idct_first::<8>(4, r),
+            (5, ..=8) => return tx.idct_first::<8>(5, r),
+            (5, ..=16) => return tx.idct_first::<16>(5, r),
+            (6, ..=8) => return tx.idct_first::<8>(6, r),
+            (6, ..=16) => return tx.idct_first::<16>(6, r),
+            (6, ..=32) => return tx.idct_first::<32>(6, r),
+            _ => {}
+        }
+    }
+    run_lanes(t, kind, n, r)
 }
 
