+    /// [`Self::idct`] for an input that is zero from `K` on. The same
+    /// network on a copy whose entries from `K` on are zeros the compiler
+    /// can see: what they feed folds away (a rotation of two zeros is
+    /// zero, a butterfly with a zero is its other input clamped), with no
+    /// arithmetic written a second time.
+    #[inline(always)]
+    fn idct_first<const K: usize>(&mut self, n: u32, r: u32) {
+        let len = 1usize << n;
+        let mut a = [L::zero(); 64];
+        a[..K].copy_from_slice(&self.t[..K]);
+        Tx { t: &mut a[..len] }.idct(n, r);
+        self.t[..len].copy_from_slice(&a[..len]);
+    }
